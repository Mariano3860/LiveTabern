# Local development defaults. Copy to .env and set a long random admin token.
ADMIN_TOKEN=
DIRECTOR_MODE=rules
WORLD_DB=.local/world.sqlite
PORT=3001
# Optional local annotation preview. External providers are not connected.
AI_MODE=off
AI_DAILY_CALLS=20
AI_MONTHLY_CALLS=200
AI_DAILY_MICRO_USD=0
AI_MONTHLY_MICRO_USD=0
AI_TIMEOUT_MS=2000
